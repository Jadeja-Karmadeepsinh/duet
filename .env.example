# ==============================================================================
# Focus Tracker Environment Configuration Template
# ==============================================================================
# Copy this file to .env in local development. Never commit real secrets to git.
#
# ENVIRONMENT VARIABLE PLACEMENT & VISIBILITY RULES:
# - Root .env: Loaded by both apps/api and apps/web during local monorepo execution.
# - Hosting Provider Dashboard: Set variables in each respective service settings.
# - SECURITY GUARANTEE: DATABASE_URL, DATABASE_URL_UNPOOLED, SESSION_SECRET,
#   APP_INVITE_CODE, CRON_SECRET, and API_PROXY_TARGET are strictly SERVER-ONLY.
#   They are NEVER prefixed with NEXT_PUBLIC_ and NEVER included in client bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL) - Server-only (Required by apps/api)
# ------------------------------------------------------------------------------
# DATABASE_URL:
#   Purpose: Connection pooler URL for active application runtime (queries, transactions).
#   Secret: YES (Contains database credentials).
#   Location: apps/api environment (and root .env for local monorepo).
#   Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# DATABASE_URL_UNPOOLED (or DATABASE_MIGRATION_URL):
#   Purpose: Direct (non-pooled) Neon connection string for DDL schema migrations (drizzle-kit migrate).
#            Neon connection pooling uses PgBouncer, which does not support DDL advisory locks.
#   Secret: YES (Contains database credentials).
#   Location: apps/api environment / Release Command step.
#   Format: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require (Notice NO '-pooler')
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-sample.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVICE (apps/api) - Server-only
# ------------------------------------------------------------------------------
# PORT:
#   Purpose: TCP port the Express server listens on.
#   Secret: NO.
#   Default: 8000 (Cloud providers like Render/Railway automatically inject PORT).
PORT=8000

# NODE_ENV:
#   Purpose: Runtime mode. Set to 'production' on deployed instances to enforce
#            cookie Secure flag, strict session secret checks, and optimize logging.
#   Secret: NO.
#   Values: development | production | test
NODE_ENV=development

# SESSION_SECRET:
#   Purpose: Cryptographic key for hashing revocable session auth tokens and HMACs.
#   Secret: YES.
#   Constraint: In production, MUST be at least 32 characters (e.g., generate via `openssl rand -hex 32`).
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-production"

# APP_INVITE_CODE (also supported as INVITE_CODE):
#   Purpose: Shared secret code required to create new team profiles (capped at 4 profiles max).
#   Secret: YES.
APP_INVITE_CODE="focus-team-invite-code"
INVITE_CODE="focus-team-invite-code"

# CRON_SECRET (also supported as JOB_SECRET):
#   Purpose: Token protecting scheduled snapshot triggers (10:00, 18:00, 22:00 IST).
#            External schedulers pass this via Authorization: Bearer <CRON_SECRET> or X-Cron-Secret header.
#   Secret: YES.
CRON_SECRET="replace-with-a-secure-random-32-byte-cron-secret-key"
JOB_SECRET="replace-with-a-secure-random-32-byte-cron-secret-key"

# CLIENT_ORIGIN:
#   Purpose: CORS allowed origin for Express API. In production, set to your frontend domain.
#   Secret: NO.
#   Sample: https://focusduo.vercel.app (or http://localhost:3000 locally)
CLIENT_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. FRONTEND WEB SERVICE (apps/web) - Server-only
# ------------------------------------------------------------------------------
# API_PROXY_TARGET:
#   Purpose: Backend destination for Next.js same-origin `/api/*` reverse proxy rewrites.
#            Allows frontend to forward HttpOnly session cookies without cross-origin issues.
#   Secret: NO (Internal service routing URL, server-side only in next.config.ts).
#   Sample: https://focus-duo-api.onrender.com (or internal service URL http://api:8000)
API_PROXY_TARGET="http://localhost:8000"
