# Focus Tracker Environment Configuration Template
# Copy this file to .env in local development. Never commit real secrets.

# ==========================================
# Database (Neon PostgreSQL) - API server only
# ==========================================
DATABASE_URL="postgresql://username:password@ep-sample-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Backend API (apps/api)
# ==========================================
PORT=8000
NODE_ENV=development
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-string"
INVITE_CODE="focus-team-invite-code"
JOB_SECRET="cron-snapshot-trigger-secret-key"

# ==========================================
# Frontend Web (apps/web)
# ==========================================
# Destination for same-origin /api/v1 reverse proxy (server-only, never NEXT_PUBLIC_)
API_PROXY_TARGET="http://localhost:8000"
