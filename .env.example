# Focus Tracker Environment Configuration Template
# Copy this file to .env in local development. Never commit real secrets.
#
# Environment Variable Placement & Visibility:
# - Root .env: Loaded by backend runner (apps/api) and Next.js (apps/web) during monorepo execution.
# - apps/api/.env.example: Dedicated environment template for the Express backend.
# - apps/web/.env.example: Dedicated environment template for the Next.js frontend.
# - SERVER-ONLY GUARANTEE: DATABASE_URL, SESSION_SECRET, INVITE_CODE, JOB_SECRET, and API_PROXY_TARGET
#   are server-only variables. They are never prefixed with NEXT_PUBLIC_ and are never bundled into client JS.

# ==========================================
# Database (Neon PostgreSQL) - Server-only (API Server)
# ==========================================
DATABASE_URL="postgresql://username:password@ep-sample-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Backend API Server (apps/api) - Server-only
# ==========================================
PORT=8000
NODE_ENV=development
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-string"
INVITE_CODE="focus-team-invite-code"
CRON_SECRET="cron-snapshot-trigger-secret-key"
JOB_SECRET="cron-snapshot-trigger-secret-key"
CLIENT_ORIGIN="http://localhost:3000"

# ==========================================
# Frontend Web (apps/web) - Server-only
# ==========================================
# Destination for same-origin /api/* reverse proxy (server-only, never NEXT_PUBLIC_)
API_PROXY_TARGET="http://localhost:8000"
