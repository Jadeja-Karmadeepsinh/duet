{
  "name": "focus-tracker-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"api,web\" -c \"blue,green\" \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --recursive --filter \"./apps/*\" run build",
    "lint": "pnpm --recursive --filter \"./apps/*\" run lint",
    "typecheck": "pnpm --recursive --filter \"./apps/*\" run typecheck",
    "test": "pnpm --recursive --filter \"./apps/*\" run test",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:check": "pnpm --filter api db:check"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3"
  }
}
