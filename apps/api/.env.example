# ==============================================================================
# Focus Tracker - Express API Server Environment Configuration (apps/api)
# ==============================================================================
# All variables in this file are strictly SERVER-ONLY. Never expose to client bundles.

# Database (Neon PostgreSQL)
# Runtime pooled connection (PgBouncer)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection (Required for DDL migrations: drizzle-kit migrate / db:migrate)
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-sample.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Service Configuration
PORT=8000
NODE_ENV=development

# Security Secrets (Generate via `openssl rand -hex 32`)
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-production"
APP_INVITE_CODE="focus-team-invite-code"
INVITE_CODE="focus-team-invite-code"
CRON_SECRET="replace-with-a-secure-random-32-byte-cron-secret-key"
JOB_SECRET="replace-with-a-secure-random-32-byte-cron-secret-key"

# CORS Origin (Frontend domain)
CLIENT_ORIGIN="http://localhost:3000"
