# ==============================================================================
# Focus Tracker - Next.js Web Application Environment Configuration (apps/web)
# ==============================================================================
# All variables in this file are strictly SERVER-ONLY.
# Do NOT prefix API_PROXY_TARGET with NEXT_PUBLIC_.
# This ensures secrets and internal backend URLs are never exposed in browser JS bundles.

PORT=3000
NODE_ENV=development

# Target URL for the Next.js same-origin `/api/*` and `/health` reverse proxy rewrites.
# In local development: http://localhost:8000
# In production on Vercel: Set to your deployed API service URL (e.g., https://focus-duo-api.onrender.com)
API_PROXY_TARGET="http://localhost:8000"
